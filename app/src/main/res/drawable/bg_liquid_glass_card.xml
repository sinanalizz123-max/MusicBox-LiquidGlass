<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. BASE LAYER (Thin Glass) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" /> <!-- 10% White -->
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- 2. INNER GLOW (Top) -->
    <item android:top="0.5dp" android:left="0.5dp" android:right="0.5dp" android:bottom="10dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- 3. CRISP OUTER HAIRLINE -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="0.5dp" android:color="#66FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
