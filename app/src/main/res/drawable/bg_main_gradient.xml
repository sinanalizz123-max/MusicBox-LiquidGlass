<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Color (Deep Liquid Blue) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A1B4B" />
        </shape>
    </item>

    <!-- Liquid Blob 1 (Top Left - Pink/Magenta) -->
    <item android:top="-150dp" android:left="-150dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="450dp"
                android:startColor="#66FF00CC"
                android:endColor="#00000000"
                android:centerX="0.5"
                android:centerY="0.5" />
        </shape>
    </item>

    <!-- Liquid Blob 2 (Bottom Right - Cyan/Blue) -->
    <item android:bottom="-100dp" android:right="-100dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="400dp"
                android:startColor="#660099FF"
                android:endColor="#00000000"
                android:centerX="0.5"
                android:centerY="0.5" />
        </shape>
    </item>

    <!-- Liquid Blob 3 (Center - Purple) -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="600dp"
                android:startColor="#4D333399"
                android:endColor="#00000000"
                android:centerX="0.7"
                android:centerY="0.4" />
        </shape>
    </item>
</layer-list>
