<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. The Deepest space base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#010103" />
        </shape>
    </item>

    <!-- 2. Ultra-Saturated Liquid Blobs (Mesh Style) -->
    <!-- Magenta Blob -->
    <item android:top="-300dp" android:left="-250dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="700dp"
                android:startColor="#CCFF0080"
                android:endColor="#00000000"
                android:centerX="0.5"
                android:centerY="0.5" />
        </shape>
    </item>

    <!-- Cyan/Electric Blue Blob -->
    <item android:bottom="-250dp" android:right="-200dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="650dp"
                android:startColor="#CC00E5FF"
                android:endColor="#00000000"
                android:centerX="0.5"
                android:centerY="0.5" />
        </shape>
    </item>

    <!-- Neon Purple Blob -->
    <item android:top="0dp" android:right="-300dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="800dp"
                android:startColor="#B37A00FF"
                android:endColor="#00000000"
                android:centerX="0.5"
                android:centerY="0.5" />
        </shape>
    </item>
    
    <!-- Vivid Blue filling blob -->
    <item android:bottom="0dp" android:left="-150dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="600dp"
                android:startColor="#990022FF"
                android:endColor="#00000000"
                android:centerX="0.5"
                android:centerY="0.5" />
        </shape>
    </item>
</layer-list>
