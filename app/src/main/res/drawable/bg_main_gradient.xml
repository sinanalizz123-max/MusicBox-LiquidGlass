<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. The Deepest space base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#010103" />
        </shape>
    </item>

    <!-- 2. ULTRA-SATURATED LIQUID BLOBS (Vibrant Mesh Style) -->
    
    <!-- Top Left: Electric Magenta -->
    <item android:top="-200dp" android:left="-150dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="600dp"
                android:startColor="#E6FF0080"
                android:endColor="#00000000"
                android:centerX="0.5"
                android:centerY="0.5" />
        </shape>
    </item>

    <!-- Bottom Right: Cyan Glow -->
    <item android:bottom="-200dp" android:right="-150dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="700dp"
                android:startColor="#E600E5FF"
                android:endColor="#00000000"
                android:centerX="0.5"
                android:centerY="0.5" />
        </shape>
    </item>

    <!-- Top Right: Deep Purple Ripple -->
    <item android:top="-50dp" android:right="-250dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="750dp"
                android:startColor="#CC7A00FF"
                android:endColor="#00000000"
                android:centerX="0.5"
                android:centerY="0.5" />
        </shape>
    </item>
    
    <!-- Bottom Left: Neon Blue Pulse -->
    <item android:bottom="-100dp" android:left="-200dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="650dp"
                android:startColor="#CC0044FF"
                android:endColor="#00000000"
                android:centerX="0.5"
                android:centerY="0.5" />
        </shape>
    </item>

    <!-- Center: Soft Ambient Glow (The "Liquid" connection) -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="500dp"
                android:startColor="#1AFFFFFF"
                android:endColor="#00000000"
                android:centerX="0.5"
                android:centerY="0.5" />
        </shape>
    </item>

    <!-- 3. TOP-DOWN LIGHT LEAK -->
    <item android:top="-100dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
