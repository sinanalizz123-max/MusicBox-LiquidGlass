<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. The Modern Optically Clear Base -->
    <!-- Minimal white tint for high-end refraction look -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" /> <!-- 10% White -->
            <corners android:radius="32dp" />
        </shape>
    </item>
    
    <!-- 2. The Hairline Highlight (Top Edge Only) -->
    <!-- This creates the crisp "Modern" glass edge -->
    <item android:bottom="0.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <stroke android:width="0.5dp" android:color="#80FFFFFF" />
        </shape>
    </item>

    <!-- 3. The Refraction Rim (Bottom Shadow) -->
    <!-- Subtle dark edge at the bottom to ground the element -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <stroke android:width="1dp" android:color="#1A000000" />
        </shape>
    </item>

    <!-- 4. Inner Vibrancy (Subtle Inner Glow) -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <stroke android:width="0.5dp" android:color="#33FFFFFF" />
            <corners android:radius="31dp" />
        </shape>
    </item>
</layer-list>
