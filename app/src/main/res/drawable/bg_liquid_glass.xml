<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. The Liquid Pillar Base (Ultra Clear) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF" /> <!-- Optically clear for blur -->
            <corners android:radius="100dp" />
        </shape>
    </item>
    
    <!-- 2. Specular Top Edge (The 'Liquid Drop' catch-light) -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <stroke android:width="0.8dp" android:color="#B3FFFFFF" /> <!-- 70% White Rim -->
            <corners android:radius="100dp" />
        </shape>
    </item>

    <!-- 3. Hairline Out Rim (Modern iOS/SimpMusic look) -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="0.5dp" android:color="#66FFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>

    <!-- 4. Subtle Inner Depth -->
    <item android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <stroke android:width="0.5dp" android:color="#1A000000" />
        </shape>
    </item>
</layer-list>
