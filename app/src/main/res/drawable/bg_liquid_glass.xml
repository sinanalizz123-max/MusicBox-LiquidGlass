<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. The Frosted Fill (Subtle dark/light base) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF" /> <!-- 15% White Base -->
            <corners android:radius="32dp" />
        </shape>
    </item>

    <!-- 2. Inner Glow (Top/Left highlight to simulate thickness) -->
    <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#40FFFFFF" /> <!-- 25% White Inner Rim -->
            <corners android:radius="31dp" />
        </shape>
    </item>

    <!-- 3. The "Lens" Specular Highlight (Radial Gradient at the top) -->
    <!-- This creates the 'Glossy' curved glass feel -->
    <item android:top="-100dp" android:left="-20dp" android:right="-20dp" android:bottom="50dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="250dp"
                android:startColor="#B3FFFFFF"
                android:endColor="#00FFFFFF"
                android:centerX="0.5"
                android:centerY="0.5" />
        </shape>
    </item>

    <!-- 4. Subtle Bottom Shadow (Inner) -->
    <item android:top="40dp" android:left="5dp" android:right="5dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#1A000000"
                android:endColor="#00000000" />
            <corners android:bottomLeftRadius="32dp" android:bottomRightRadius="32dp" />
        </shape>
    </item>

    <!-- 5. Advanced Border (Gradient Rim) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <stroke
                android:width="1dp"
                android:color="@android:color/transparent" />
            <gradient
                android:angle="270"
                android:startColor="#80FFFFFF"
                android:centerColor="#33FFFFFF"
                android:endColor="#1AFFFFFF"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- Hairline stroke to ensure crisp edges -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <stroke android:width="0.5dp" android:color="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>
