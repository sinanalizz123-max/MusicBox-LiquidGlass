<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main Glass Body -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_white_thin" />
            <corners android:radius="32dp" />
        </shape>
    </item>

    <!-- Inner Glow / Thickness -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/glass_inner_glow" />
            <corners android:radius="31dp" />
        </shape>
    </item>

    <!-- Specular Highlight (Top Edge) -->
    <item android:bottom="40dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/glass_highlight"
                android:endColor="@android:color/transparent" />
            <corners android:topLeftRadius="32dp" android:topRightRadius="32dp" />
        </shape>
    </item>

    <!-- Border -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/glass_border" />
            <corners android:radius="32dp" />
        </shape>
    </item>
</layer-list>
