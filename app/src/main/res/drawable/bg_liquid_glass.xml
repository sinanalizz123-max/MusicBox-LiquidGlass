<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. The ultra-clear liquid base (Transparent, letting blur show through) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF" /> <!-- Fully Transparent -->
            <corners android:radius="32dp" />
        </shape>
    </item>
    
    <!-- 2. The Liquid Surface Shimmer (Diagonal gloss) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1AFFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#1AFFFFFF" />
            <corners android:radius="32dp" />
        </shape>
    </item>

    <!-- 3. Primary Specular Highlight (The 'Wet' look) -->
    <!-- Creating a sharp reflection at the top -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="45dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#E6FFFFFF"
                android:centerColor="#33FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="32dp" android:topRightRadius="32dp" />
        </shape>
    </item>

    <!-- 4. Inner Glass Edge (Refraction Rim) -->
    <!-- Mimics the physical edge of thick glass -->
    <item android:left="0.8dp" android:top="0.8dp" android:right="0.8dp" android:bottom="0.8dp">
        <shape android:shape="rectangle">
            <stroke android:width="0.8dp" android:color="#99FFFFFF" /> <!-- 60% White Crisp Edge -->
            <corners android:radius="31.2dp" />
        </shape>
    </item>

    <!-- 5. Bottom Rim Reflection -->
    <item android:top="55dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#66FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:bottomLeftRadius="32dp" android:bottomRightRadius="32dp" />
        </shape>
    </item>
</layer-list>
