<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. The Liquid Base (Deep Transparency) -->
    <!-- SimpMusic uses a subtle dark tint for depth -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A000000" /> <!-- 10% Black Overlay -->
            <corners android:radius="100dp" /> <!-- Perfect Pill -->
        </shape>
    </item>
    
    <!-- 2. The Specular Edge (Hairline Refraction) -->
    <item android:left="1.2dp" android:top="1.2dp" android:right="1.2dp" android:bottom="1.2dp">
        <shape android:shape="rectangle">
            <stroke android:width="0.6dp" android:color="#80FFFFFF" /> <!-- 50% White Crisp Rim -->
            <corners android:radius="99dp" />
        </shape>
    </item>

    <!-- 3. Bottom Shadow (Refraction Grounding) -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <stroke android:width="0.8dp" android:color="#33000000" />
        </shape>
    </item>
</layer-list>
