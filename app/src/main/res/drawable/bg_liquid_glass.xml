<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. ULTRA-PURE REFRACTION BASE -->
    <!-- Mimics the deep refraction of thick liquid glass -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#08FFFFFF" /> <!-- 3% White for extreme clarity -->
            <corners android:radius="100dp" />
        </shape>
    </item>

    <!-- 2. INNER LIQUID DEPTH (Deep Set-in) -->
    <!-- Adds the "liquid" thickness feel -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <stroke android:width="4dp" android:color="#0A000000" /> <!-- 4% Black inner depth -->
            <corners android:radius="99dp" />
        </shape>
    </item>

    <!-- 3. CHROMATIC RIM (Refractive Hairline) -->
    <!-- Gradient stroke to catch light like a real glass edge -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" /> <!-- 30% White Rim Base -->
        </shape>
    </item>

    <!-- 4. LENS SPECULAR REFLECTION (Top-Down Light) -->
    <!-- The "Liquid" signature - a sharp lens-like reflection -->
    <item android:top="1dp" android:left="10dp" android:right="10dp" android:bottom="40dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#E6FFFFFF"
                android:centerColor="#33FFFFFF"
                android:endColor="#00FFFFFF"
                android:centerX="0.5" />
            <corners android:topLeftRadius="100dp" android:topRightRadius="100dp" />
        </shape>
    </item>

    <!-- 5. AMBIENT CAUSTICS (Secondary Reflection) -->
    <item android:top="25dp" android:bottom="15dp" android:left="5dp" android:right="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1AFFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#1AFFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>

    <!-- 6. BOTTOM BOUNCE LIGHT (Inner Glow) -->
    <item android:top="50dp" android:left="20dp" android:right="20dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#4DFFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:bottomLeftRadius="100dp" android:bottomRightRadius="100dp" />
        </shape>
    </item>
    
    <!-- 7. ULTRA-SHARP OUTER RIM -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <stroke android:width="0.3dp" android:color="#B3FFFFFF" /> <!-- 70% White for razor sharpness -->
        </shape>
    </item>
</layer-list>
