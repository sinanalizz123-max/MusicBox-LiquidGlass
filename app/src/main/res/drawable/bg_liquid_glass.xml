<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. The High-Clarity Liquid Pill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" /> <!-- 8% White - Extremely Clear -->
            <corners android:radius="100dp" /> <!-- Full Pill Shape -->
        </shape>
    </item>
    
    <!-- 2. The Specular Refraction (Modern iOS style) -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <stroke android:width="0.5dp" android:color="#66FFFFFF" />
            <corners android:radius="99dp" />
        </shape>
    </item>

    <!-- 3. Shadow for Depth -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <stroke android:width="1dp" android:color="#1A000000" />
        </shape>
    </item>
</layer-list>
